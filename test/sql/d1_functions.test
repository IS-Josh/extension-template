# name: test_d1_functions
# description: test D1 extension functions
# group: [sql]

require cloudflare_d1

statement ok
LOAD 'cloudflare_d1';

# Test basic cloudflare_d1 function
query I
SELECT cloudflare_d1('test');
----
CloudflareD1 test 🐥

# Test d1_query function (will fail with invalid credentials, but should show proper error)
statement error
SELECT * FROM d1_query('SELECT 1 as x', 'test_account', 'test_token', 'test_db');
----
D1 query bind failed

# Test d1_execute function (will fail with invalid credentials, but should show proper error)
statement error
SELECT d1_execute('SELECT 1', 'test_account', 'test_token', 'test_db');
----
D1 execute failed

# Test d1_insert function (will fail with invalid credentials, but should show proper error)
statement error
SELECT d1_insert('test_table', 'test_account', 'test_token', 'test_db', 'col1', 'val1', 'col2', 'val2');
----
D1 INSERT failed

# Test d1_update function (will fail with invalid credentials, but should show proper error)
statement error
